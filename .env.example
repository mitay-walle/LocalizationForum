# Postgres (Neon: используй pooled connection string)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Секрет для подписи сессий (любая длинная случайная строка)
JWT_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Callback URL: https://<твой-проект>.vercel.app/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Откуда разрешены запросы к API (через запятую): GitHub Pages и сам Vercel
SITE_ORIGINS=https://<org>.github.io,https://<твой-проект>.vercel.app

# GitHub-логины администраторов (через запятую)
ADMIN_LOGINS=

# Токен для Actions в репо игр (импорт исходных строк). Любая длинная случайная строка.
SYNC_TOKEN=

# Необязательно: fine-grained PAT (Contents: write на репо игр) —
# после утверждения API дёргает repository_dispatch, и перевод коммитится сразу, а не по расписанию.
GITHUB_DISPATCH_TOKEN=

# Только для локальной разработки: вход без GitHub через /api/auth/dev?login=имя
DEV_AUTH=1

# Антиспам: лимиты на предложение вариантов (модераторы языка и администраторы не ограничены). 0 — без лимита.
VARIANTS_PER_USER_STRING=3
VARIANTS_PER_STRING=30
VARIANTS_PER_HOUR=500
